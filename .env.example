# Copy to .env on the server and fill in secrets:
#   cp .env.example .env
#
# Staging and production must use different Telegram bot tokens.
# Never reuse a Phuket bot token.
#
# Keep POSTGRES_* and DATABASE_URL in sync (same user/password/db).
# Passwords with @ : / # % etc. are fine — the app URL-encodes POSTGRES_*.

TELEGRAM_BOT_TOKEN=
# TGTrack ("Откуда Подписки") key for this bot. Empty disables forwarding.
# Start and block updates are posted unchanged to
# https://bot-api.tgtrack.ru/v1/{TGTRACK_API_KEY}/on_telegram_webhook
# Use Bali's own key, not the Phuket bot key.
TGTRACK_API_KEY=
OPENAI_API_KEY=
# Google Cloud key with the Places API (New) enabled. Empty = Mike answers
# without looking up real places, so he may name a place that does not exist.
GOOGLE_PLACES_API_KEY=
# Comma-separated Telegram user/chat ids that receive real-estate leads.
ADMIN_CHAT_ID=
# Signs admin panel login tokens. Required for the admin-api container.
ADMIN_JWT_SECRET=
# Host port for the admin panel. nginx proxies /api to admin-api.
ADMIN_WEB_PORT=8080
# Host port for the partner cabinet. nginx proxies /api and /r to admin-api.
PARTNER_WEB_PORT=8081
# Host port for the Telegram Mini App. Caddy proxies the public HTTPS name to it.
# The service starts only with: docker compose --profile tma up
TMA_WEB_PORT=8082
# Public http(s) origin of partner-web. Telegram offer buttons are rewritten
# to {PARTNER_OFFER_BASE_URL}/r/… so clicks can be counted. Empty keeps the
# partner's own URL and records no views.
PARTNER_OFFER_BASE_URL=

# Partner logos. Same bucket and key on staging and production.
# S3_KEY_PREFIX is prod on the production Droplet and staging on the staging Droplet.
# The secret is created in Spaces → Access Keys and is shown once.
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
S3_BUCKET=mikebali
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.mikebaliai.com
S3_KEY_PREFIX=

POSTGRES_USER=mike
POSTGRES_PASSWORD=
POSTGRES_DB=mike_bali

# Local host. On Docker Compose, POSTGRES_HOST=db is injected; password is
# taken from POSTGRES_PASSWORD (encoded), not from a raw URL override.
DATABASE_URL=postgresql://mike:@localhost:5432/mike_bali
TEST_DATABASE_URL=postgresql://localhost/mike_bali_test
